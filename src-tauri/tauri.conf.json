{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ascii-converter",
  "version": "0.1.0",
  "identifier": "com.ascii-converter.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "title": "ascii-converter",
        "width": 600,
        "height": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
